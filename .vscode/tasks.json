{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pio-build-native",
      "type": "shell",
      "command": "pio",
      "args": ["run", "-e", "native"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Upload (native)",
      "type": "shell",
      "command": "pio",
      "args": ["run", "--target", "upload", "--environment", "native"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}